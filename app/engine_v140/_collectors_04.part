        ))
        i+=1

    if not out:
        flat=re.sub(r'\s+',' ',text)
        pat=re.compile(
            r'(?:Filiale(?:\s*&\s*Shop)?\s+)?([A-ZÄÖÜ0-9][A-Za-zÄÖÜäöüß0-9&\'’.,+\-/ ]{2,110}?)\s+'
            r'(\d+(?:[.,]\d+)?\s*(?:kg|g|l|ml|Stück|Stk\.?))'
            r'(.{0,260}?)(?:(?:statt|UVP)\s+(\d{1,3}[.,]\d{2})\s+(\d{1,3}[.,]\d{2})|(Aktion)\s+(\d{1,3}[.,]\d{2}))',
            re.I
        )
        for m in pat.finditer(flat):
            name=clean_product_name(m.group(1).strip())
            if product_name_issue(name):
                continue
            quantity_text=m.group(2)
            tail=m.group(3) or ''
            q,u=size(quantity_text)
            if m.group(4):
                regular=float(m.group(4).replace(',','.')); promo=float(m.group(5).replace(',','.'))
            else:
                regular=None;promo=float(m.group(7).replace(',','.'))
            block=flat[m.start():min(len(flat),m.end()+160)]
            after=flat[m.end():min(len(flat),m.end()+100)]
            app_price=None
            if re.search(r'\b(?:app|netto\+|coupon|vorteilspreis|digitaler\s+coupon)\b',after,re.I):
                extra=_price_without_unit_prices(after)
                app_price=min([v for v in extra if v<promo],default=None)
            im=best_img(imgs,name)
            out.append(CollectedOffer(
                source.key,source.store_name,source.retailer,name[:180],cat(name),promo,
                regular_price=regular,app_price=app_price,unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,
                source_text=block,source_url=source.url,image_url=im['url'] if im else None,
                image_alt=im['alt'] if im else None,confidence=.92
            ))
    seen=set();res=[]
    for r in out:
        k=(r.product_name.lower(),r.price,r.quantity,r.unit)
        if k not in seen:
            seen.add(k);res.append(r)
    return res

def parse_aldi_text(source,text,imgs=None):
    imgs=imgs or [];L=[x.strip() for x in text.splitlines() if x.strip()];out=[]

    low_text=text.lower()
    store_tokens=[t.lower() for t in re.split(r"\s+|-",source.store_name) if len(t)>=4 and t.lower() not in {"aldi","süd"}]
    has_store_context=any(t in low_text for t in store_tokens)
    asks_for_store=(
        "wähle deine filiale" in low_text or
        "filialauswahl" in low_text or
        "filiale auswählen" in low_text
    )
    if asks_for_store and not has_store_context:
        return []
    from .week_utils import parse_any_date
    week_re=re.compile(r'Wochenangebote\s+Mo\.,?\s*(\d{1,2}\.\d{1,2}\.?)\s*[–-]\s*Sa\.,?\s*(\d{1,2}\.\d{1,2}\.?)',re.I)
    current_vf=current_vt=None
    i=0
    while i<len(L):
        line=L[i]
        wm=week_re.search(line)
        if wm:
            current_vf=parse_any_date(wm.group(1));current_vt=parse_any_date(wm.group(2))
            i+=1;continue

        q,u=size(line)
        candidate_idx=i
        if q is None:
            found=None
            for k in range(i+1,min(i+5,len(L))):
                if size(L[k])[0] is not None:
                    found=k;break
                if week_re.search(L[k]): break
            if found is None:
                i+=1;continue
            candidate_idx=found
            q,u=size(L[found])
            name_parts=[x for x in L[i:found] if not _is_noise_line(x) and not PRICE.search(x)]
            name=' '.join(name_parts[-2:]).strip() if name_parts else None
        else:
            name=line
            if re.fullmatch(r'.*\b\d+(?:[.,]\d+)?\s*(?:kg|g|l|ml)\b',line,re.I) and len(line)<18:
                name=_best_candidate_name(L,i-3,i)

        if not name or _is_noise_line(name):
            i+=1;continue

        block_end=min(len(L),candidate_idx+9)
        for stop in range(candidate_idx+1,block_end):
            stop_low=L[stop].lower()
            if (
                stop_low.startswith('alle wochenangebote') or
                stop_low.startswith('angebote ab ') or
                (stop>candidate_idx+1 and week_re.search(L[stop]))
            ):
                block_end=stop
                break
        block=' '.join(L[max(0,i):block_end])
        vals=_price_without_unit_prices(block)
        if not vals:
            i+=1;continue
        price=min(vals)
        regular=None
        strike=re.search(r'(?:statt|UVP|~+)\s*(\d{1,3}[.,]\d{2})',block,re.I)
        if strike:
            val=float(strike.group(1).replace(',','.'))
            if val>price: regular=val
        if regular is None:
            higher=[v for v in vals if v>price]
            regular=max(higher) if higher else None

        im=best_img(imgs,name)
        out.append(CollectedOffer(
            source.key,source.store_name,source.retailer,name[:180],cat(name),price,
            regular_price=regular,unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,
            valid_from=current_vf.strftime('%d.%m.%Y') if current_vf else None,
            valid_to=current_vt.strftime('%d.%m.%Y') if current_vt else None,
            source_text=block,source_url=source.url,image_url=im['url'] if im else None,
            image_alt=im['alt'] if im else None,confidence=.96 if current_vf else .74
        ))
        i=max(i+1,candidate_idx+1)

    seen=set();res=[]
    for r in out:
        k=(r.product_name.lower(),r.price,r.valid_from,r.quantity,r.unit)
        if k not in seen:
            seen.add(k);res.append(r)
    return res

def parse_lidl_text(source,text,imgs=None):
    imgs=imgs or [];L=[x.strip() for x in text.splitlines() if x.strip()];out=[]
    from .week_utils import infer_validity
    vf,vt,_,_=infer_validity(text)
    for i,line in enumerate(L):
        block=' '.join(L[max(0,i-3):min(i+6,len(L))]);low=block.lower()
        if not any(x in low for x in ('in der filiale','in unseren filialen','filialpreis','nur in der filiale','im markt')): continue
        keep,_=classify_offer(block,source.url)
        if not keep or not SIZE.search(block): continue
        vals=_price_without_unit_prices(block)
        if not vals: continue
        if PRICE.search(line) or SIZE.search(line): continue
        q,u=size(block);im=best_img(imgs,line)
        out.append(CollectedOffer(
            source.key,source.store_name,source.retailer,line[:180],cat(line),vals[-1],
            regular_price=max(vals[:-1]) if len(vals)>1 and max(vals[:-1])>vals[-1] else None,
            unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,
            valid_from=vf.strftime('%d.%m.%Y') if vf else None,
            valid_to=vt.strftime('%d.%m.%Y') if vt else None,
            source_text=block,source_url=source.url,image_url=im['url'] if im else None,
            image_alt=im['alt'] if im else None,confidence=.86 if vf else .76
        ))
    return out


def _rewe_offer_period(row):
    from ..clock import app_today
    from .week_utils import classify_week, parse_any_date

    valid_from=parse_any_date(str(getattr(row,'valid_from',None) or ''),app_today())
    return classify_week(valid_from,app_today()) if valid_from else None


def _collected_rewe_structured_offer(source,row):
    block=str(row.get('source_text') or '')
    q,u=size(block)
    return CollectedOffer(
        source.key,source.store_name,source.retailer,
        str(row.get('product_name') or '')[:180],
        str(row.get('category') or '') or cat(str(row.get('product_name') or '')),
        float(row['price']),
        regular_price=None,
        unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,
        valid_from=row.get('valid_from'),valid_to=row.get('valid_to'),
        source_text=block,source_url=source.url,
        image_url=row.get('image_url'),image_alt=row.get('image_alt'),
        confidence=.99,
    )


def _merge_rewe_week_horizon(source,raw,ctype,fetch_mode,final_url,visible_text,imgs,offers):
    from .rewe_week_horizon import (
        append_rewe_audit_appendix,
        parse_rewe_structured_weeks,
        visible_next_week_is_published,
    )

    html=raw.decode('utf-8',errors='replace')
    structured_rows,meta=parse_rewe_structured_weeks(html)
    rendered=None

    # During Sunday-Friday REWE explicitly says "Nächste Woche – Ab Samstag".
    # Do not pay the browser cost or fabricate a future cohort in that state.
    # Once the official page exposes a dated next-week range, capture the same
    # page in Chromium so its structured network responses are available too.
    if not meta.get('structured_found') and visible_next_week_is_published(visible_text):
        rendered=browser_fetch(source.url,drain_offer_surface=True)
        html=rendered.content.decode('utf-8',errors='replace')
        structured_rows,meta=parse_rewe_structured_weeks(html)

    coverage={period for period in (_rewe_offer_period(row) for row in offers) if period in {'current','next'}}
    structured_by_period={
        period:[row for row in structured_rows if row.get('period')==period]
        for period in ('current','next')
    }

    warning_parts=[]
    if meta.get('structured_found'):
        warning_parts.extend(meta.get('errors') or [])
        if meta.get('next_available') and not structured_by_period['next']:
            warning_parts.append('rewe_next_week_available_but_empty')
        if not structured_by_period['current']:
            warning_parts.append('rewe_structured_current_empty')

        existing={
            (o.product_name.lower(),o.price,o.valid_from,o.quantity,o.unit)
            for o in offers
        }
        for period in ('current','next'):
            # Keep the proven visible-card parser as primary for whichever week
            # the official page currently renders. Structured rows fill only a
            # missing cohort, so this change cannot silently replace current QA.
            if period in coverage:
                continue
            for row in structured_by_period[period]:
                offer=_collected_rewe_structured_offer(source,row)
                key=(offer.product_name.lower(),offer.price,offer.valid_from,offer.quantity,offer.unit)
                if key not in existing:
                    offers.append(offer);existing.add(key)

        if structured_rows and (meta.get('next_available') or len(coverage)<2):
            html=append_rewe_audit_appendix(html,structured_rows)
            raw=html.encode('utf-8')
            if rendered is not None:
                ctype=rendered.content_type
                fetch_mode=f"{rendered.mode}+rewe-structured-weeks"
                final_url=rendered.final_url
            else:
                fetch_mode=f"{fetch_mode}+rewe-structured-weeks"
    elif visible_next_week_is_published(visible_text):
        warning_parts.append('rewe_next_week_published_but_not_captured')

    diagnostics={
        'rewe_current_offer_count':sum(1 for row in offers if _rewe_offer_period(row)=='current'),
        'rewe_next_week_offer_count':sum(1 for row in offers if _rewe_offer_period(row)=='next'),
        'rewe_structured_found':bool(meta.get('structured_found')),
        'rewe_structured_next_available':bool(meta.get('next_available')),
    }
    return raw,ctype,fetch_mode,final_url,offers,';'.join(sorted(set(warning_parts))),diagnostics


def collect_one(source):
    raw,ctype,fetch_mode,final_url=fetch_source(source); html=raw.decode('utf-8',errors='replace'); visible_text=visible(html); imgs=images(html,final_url or source.url)
    fn={'Netto Marken-Discount':parse_netto_text,'ALDI SÜD':parse_aldi_text,'EDEKA':parse_edeka_text,'REWE':parse_rewe_text,'Lidl':parse_lidl_text}.get(source.retailer)
    offers=fn(source,visible_text,imgs) if fn else []
    structured=structured_network_offers(html,source,imgs)
    if structured:
        existing={(o.product_name.lower(),o.price,o.quantity,o.unit) for o in offers}
        for o in structured:
            k=(o.product_name.lower(),o.price,o.quantity,o.unit)
            if k not in existing:
                offers.append(o);existing.add(k)
    technical_warning=''
    rewe_diagnostics={}
    if source.retailer=='REWE':
        raw,ctype,fetch_mode,final_url,offers,technical_warning,rewe_diagnostics=_merge_rewe_week_horizon(
            source,raw,ctype,fetch_mode,final_url,visible_text,imgs,offers
        )
    for o in offers:
        if o.unit_price is None:
            o.unit_price,o.unit_price_unit=compute_unit_price(o.app_price if o.app_price is not None else o.price,o.quantity,o.unit)
        elif not o.unit_price_unit:
            o.unit_price_unit=canonical_unit_price_unit(o.unit)
    result={'source':source,'raw':raw,'content_type':ctype,'fetch_mode':fetch_mode,'final_url':final_url,'offers':offers,'status':'parsed' if offers else 'no_safe_offers'}
    if technical_warning:result['technical_warning']=technical_warning
    result.update(rewe_diagnostics)
    return result
def source_status():return [asdict(s) for s in SOURCES]
