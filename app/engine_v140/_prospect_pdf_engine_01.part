PRICE_RE = re.compile(r'(?<!\d)(\d{1,3})[.,](\d{2})(?!\d)')
STAR_PRICE_RE = re.compile(r'(?<!\d)(\d{1,3}[.,]\d{2})\s*\*')
QTY_RE = re.compile(
    r'\b(?:je\s+)?(?:(\d{1,2})\s*[x×]\s*)?'
    r'(\d+(?:[.,]\d+)?)\s*[-]?\s*'
    r'(kg|g|l|liter|ml|stück|st\.?|packung|pckg\.?|becher|dose|flasche|fl\.?|btl\.?)'
    r'(?:\b|[- ])', re.I
)
UNIT_PRICE_EQ_RE = re.compile(
    r'\(\s*(?:1\s*)?(kg|l|100\s*g|100\s*ml)\s*=\s*(\d+(?:[.,]\d+)?)\s*\)', re.I
)
UNIT_PRICE_SLASH_RE = re.compile(
    r'\(?\s*(\d+(?:[.,]\d+)?)\s*(?:[–-]\s*\d+(?:[.,]\d+)?)?\s*/\s*(kg|l)\s*\)?', re.I
)
UNIT_PRICE_LABEL_RE = re.compile(r'\b(kg|l)[- ]?preis\s*(\d+(?:[.,]\d+)?)', re.I)
REGULAR_RE = re.compile(r'\b(?:UVP|statt)\s*(\d{1,3}[.,]\d{2})', re.I)

COUNTRY_PREFIXES = (
    "deutschland","niederlande","spanien","italien","frankreich","portugal","griechenland",
    "südafrika","argentinien","chile","neuseeland","belgien","österreich","usa","türkei",
    "luxemburg","simbabwe","costa rica","panama","rheinland pfalz","rheinland-pfalz",
)

GENERIC_HEADERS = {
    "aktion","knaller","xxl","sparen","bonus","bedientheke","kühlung","tiefkühlung",
    "gutes für alle.","gutes für alle","meine metzgerei","meine käsetheke","bio",
    "fleisch & wurst","fleisch","wurst","getränke","vorrat","snack","frühstück",
}
DESCRIPTOR_PREFIXES = (
    "versch.","gekühlt","tiefgekühlt","tiefgefroren","ursprung","klasse","kl.","je ",
    "kg-preis","l-preis","vom ","aus ","mit ","herzhaft","cremig","gesalzen",
    "natur oder","sorte:","sorten:","taurin","koffeinhaltig","mind.","fett ",
    "in ","am ","über ","fein ","vollfleisch","geschnitten","mariniert","frisch ",
    "grob ","ohne ","zart ","ca. ","zzgl.","1,5 %","0,0 ","11 %","24% ",
)

@dataclass(frozen=True)
class PdfBlock:
    x0: float
    y0: float
    x1: float
    y1: float
    text: str
    max_font: float = 0.0
    first_font: str = ""
    first_size: float = 0.0
    emphasis_prices: tuple[float,...] = ()

    @property
    def width(self): return max(1.0, self.x1-self.x0)

    @property
    def height(self): return max(1.0, self.y1-self.y0)

@dataclass(frozen=True)
class PdfParseResult:
    retailer: str
    page_count: int
    text_characters: int
    rows: list[CollectedOffer]
    valid_from: date|None
    valid_to: date|None
    detected_market_id: str|None
    notes: list[str]


def _lines(text:str)->list[str]:
    out=[]
    for line in (text or "").replace("\u00ad","").replace("\ufffe","").splitlines():
        line=re.sub(r"\s+"," ",line).strip(" |\t")
        if line:
            out.append(line)
    return out


def _normalize_price_text(text:str)->str:
    text=text or ""
    return text.replace("\u202f"," ").replace("\xa0"," ")


def _price_values(text:str)->list[float]:
    text=_normalize_price_text(text)
    text=re.sub(r'\([^)]*(?:/|=|kg|l)[^)]*\)', ' ', text, flags=re.I)
    text=re.sub(r'[–-]\s*\d+\s*%', ' ', text)
    vals=[]
    for m in PRICE_RE.finditer(text):
        v=float(f"{m.group(1)}.{m.group(2)}")
        if 0.01 <= v <= 5000:
            vals.append(v)
    return vals


def _extract_current_price(text:str, retailer:str)->float|None:
    text=_normalize_price_text(text)
    m=STAR_PRICE_RE.search(text)
    if m:
        return float(m.group(1).replace(",", "."))
    if retailer=="REWE" and re.search(r'\b(?:Aktion|Knaller)\b',text,re.I):
        vals=_price_values(text)
        return vals[0] if vals else None
    vals=[]
    for m in PRICE_RE.finditer(text):
        pre=text[max(0,m.start()-18):m.start()].lower()
        if any(x in pre for x in ("uvp","statt","einzelpreis","kg-preis","l-preis")):
            continue
        v=float(f"{m.group(1)}.{m.group(2)}")
        if 0.01 <= v <= 5000:
            vals.append(v)
    return vals[0] if vals else None


def _extract_regular_price(text:str, current:float|None)->float|None:
    text=_normalize_price_text(text)
    m=REGULAR_RE.search(text)
    if m:
        v=float(m.group(1).replace(",", "."))
        if current is None or v > current:
            return v
    vals=_price_values(text)
    for v in vals[1:]:
        if current is not None and v>current:
            return v
    return None


def _extract_quantity(text:str)->tuple[float|None,str|None]:
    cleaned=re.sub(r'\([^)]*(?:=|/)\s*\d+(?:[.,]\d+)?[^)]*(?:kg|l)[^)]*\)',' ',text,flags=re.I)
    m=QTY_RE.search(cleaned)
    if not m:
        return None,None
    count=float(m.group(1)) if m.group(1) else 1.0
    qty=float(m.group(2).replace(",","."))
    unit=m.group(3).lower()
    unit={
        "liter":"l","st.":"stück","st":"stück","packung":"stück",
        "pckg.":"stück","becher":"stück","dose":"stück","flasche":"stück",
        "fl.":"stück","btl.":"stück"
    }.get(unit,unit)
    return count*qty,unit


def _extract_unit_price(text:str)->tuple[float|None,str|None]:
    m=UNIT_PRICE_EQ_RE.search(text)
    if m:
        raw=m.group(1).lower().replace(" ","")
        value=float(m.group(2).replace(",","."))
        if raw=="100g": return value*10,"kg"
        if raw=="100ml": return value*10,"l"
        return value,("kg" if raw=="kg" else "l")
    m=UNIT_PRICE_LABEL_RE.search(text)
    if m:
        return float(m.group(2).replace(",",".")),m.group(1).lower()
    m=UNIT_PRICE_SLASH_RE.search(text)
    if m:
        return float(m.group(1).replace(",",".")),m.group(2).lower()
    return None,None


def _strip_origin_prefix(name:str)->str:
    text=(name or "").strip()
    low=text.lower()
    if ":" in text:
        prefix,rest=text.split(":",1)
        plow=prefix.lower()
        if any(c in plow for c in COUNTRY_PREFIXES) or "ursprung" in plow:
            text=rest.strip()
    for country in COUNTRY_PREFIXES:
        if low.startswith(country+" - "):
            text=text[len(country)+3:].strip()
            break
    return text


def _product_title(text:str, retailer:str)->str:
    ls=_lines(text)
    title=[]
    for ln in ls:
        low=ln.lower().strip(" .,:;-")
        if not low: continue
        if low in GENERIC_HEADERS: continue
        if re.fullmatch(r'[–-]?\d+\s*%',ln): continue
        if PRICE_RE.fullmatch(ln): continue
        if QTY_RE.search(ln) or UNIT_PRICE_EQ_RE.search(ln) or UNIT_PRICE_LABEL_RE.search(ln) or UNIT_PRICE_SLASH_RE.search(ln): break
        if any(low.startswith(p) for p in DESCRIPTOR_PREFIXES): break
        if low.startswith(("gültig ","kw ","mehr auf ","artikel mit diesem","preisinformationen")): continue
        if len(ln)>90: continue
        title.append(ln)
        if len(title)>=4: break
    title=[x for x in title if x.lower().strip(" .") not in GENERIC_HEADERS]
    if not title: return ""
    name=" ".join(title)
    name=_strip_origin_prefix(name)
    name=re.sub(r'^\s*oder\s+','',name,flags=re.I)
    name=re.sub(r"([A-Za-zÄÖÜäöüß])-\s+([A-Za-zÄÖÜäöüß])",r"\1\2",name)
    name=clean_product_name(name)
    return name


def _rect_distance(a:PdfBlock,b:PdfBlock)->float:
    dx=max(b.x0-a.x1,a.x0-b.x1,0.0)
    dy=max(b.y0-a.y1,a.y0-b.y1,0.0)
    d=math.hypot(dx,dy)
    x_overlap=max(0.0,min(a.x1,b.x1)-max(a.x0,b.x0))/max(1.0,min(a.width,b.width))
    y_overlap=max(0.0,min(a.y1,b.y1)-max(a.y0,b.y0))/max(1.0,min(a.height,b.height))
    if x_overlap>0.25 or y_overlap>0.25:
        d*=0.45
    return d


def _block_from_tuple(b)->PdfBlock:
    return PdfBlock(float(b[0]),float(b[1]),float(b[2]),float(b[3]),str(b[4] or "").strip())


def _line_emphasis_prices(line)->list[float]:
    all_spans=line.get("spans",[])
    spans=[sp for sp in all_spans if (sp.get("text") or "").strip()]
    if not spans: return []
    mx=max(float(sp.get("size") or 0) for sp in spans)
    text="".join(sp.get("text") or "" for sp in all_spans).strip()
    vals=[]
    if mx < 18: return vals
    for m in PRICE_RE.finditer(text):
        v=float(f"{m.group(1)}.{m.group(2)}")
        if .01<=v<=5000: vals.append(v)
    return vals


def _page_blocks(page)->list[PdfBlock]:
    out=[]
    for b in page.get_text("dict").get("blocks",[]):
        if b.get("type")!=0: continue
        lines=b.get("lines",[])
        spans=[sp for line in lines for sp in line.get("spans",[]) if (sp.get("text") or "").strip()]
        if not spans: continue
        text="\n".join("".join(sp.get("text") or "" for sp in line.get("spans",[])) for line in lines).strip()
        if not text: continue
        first=spans[0]
        emph=[]
        for line in lines: emph.extend(_line_emphasis_prices(line))
        bbox=b.get("bbox") or (0,0,0,0)
        out.append(PdfBlock(float(bbox[0]),float(bbox[1]),float(bbox[2]),float(bbox[3]),text,max(float(sp.get("size") or 0) for sp in spans),str(first.get("font") or ""),float(first.get("size") or 0),tuple(emph)))
    return out

def _x_overlap(a:PdfBlock,b:PdfBlock)->float:
    return max(0.0,min(a.x1,b.x1)-max(a.x0,b.x0))/max(1.0,min(a.width,b.width))

def _candidate_product_blocks(blocks:list[PdfBlock], retailer:str)->list[PdfBlock]:
    out=[]
    for idx,b in enumerate(blocks):
        name=_product_title(b.text,retailer)
        qty,unit=_extract_quantity(b.text)
        up,upu=_extract_unit_price(b.text)
        merged=b
        if (not name or product_name_issue(name)) and (qty is not None or up is not None):
            candidates=[]
            for prev in blocks:
                if prev is b or prev.y1>b.y0+2: continue
                gap=b.y0-prev.y1
                if gap<-5 or gap>22 or _x_overlap(prev,b)<0.35: continue
                pn=_product_title(prev.text,retailer)
                if pn and not product_name_issue(pn): candidates.append((gap,prev,pn))
            if candidates:
                candidates.sort(key=lambda x:x[0])
                prev=candidates[0][1]
                merged=PdfBlock(min(prev.x0,b.x0),prev.y0,max(prev.x1,b.x1),b.y1,prev.text+"\n"+b.text,
