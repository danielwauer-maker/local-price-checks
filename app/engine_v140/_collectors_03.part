    }

    for i,line in enumerate(L):
        marker=line.lower().strip()
        if marker not in {'aktion','knaller'}:
            continue

        price=None
        for j in range(i+1,min(len(L),i+4)):
            vals=_price_without_unit_prices(L[j])
            if vals:
                price=vals[0]
                break
        if price is None:
            continue

        package_idx=None
        for j in range(i-1,max(-1,i-5),-1):
            if SIZE.search(L[j]):
                package_idx=j
                break
        if package_idx is None:
            continue

        product=None
        for j in range(package_idx-1,max(-1,package_idx-5),-1):
            cand=L[j].strip()
            low=cand.lower()
            if (
                low in noise or
                PRICE.search(cand) or
                SIZE.search(cand) or
                low.startswith(('versch.','je ','image','rewe bonus','gültig ','diese woche'))
            ):
                continue
            if len(cand)<3 or len(cand)>180:
                continue
            product=cand
            break
        product=clean_product_name(product)
        if not product or product_name_issue(product):
            continue

        block=' '.join(L[max(0,package_idx-1):min(len(L),i+4)])
        q,u=size(L[package_idx])
        im=best_img(imgs,product)
        out.append(CollectedOffer(
            source.key,source.store_name,source.retailer,product,cat(product),price,
            unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,valid_from=vf,valid_to=vt,
            source_text=block,source_url=source.url,
            image_url=im['url'] if im else None,image_alt=im['alt'] if im else None,
            confidence=.97
        ))

    seen=set();res=[]
    for r in out:
        k=(r.product_name.lower(),r.price,r.quantity,r.unit)
        if k not in seen:
            seen.add(k);res.append(r)
    return res

def parse_edeka_text(source,text,imgs=None):
    L=[x.strip() for x in text.splitlines() if x.strip()];imgs=imgs or [];out=[]
    rvf,rvt,_,_=infer_validity(text)
    vf=rvf.strftime("%d.%m.%Y") if rvf else None
    vt=rvt.strftime("%d.%m.%Y") if rvt else None
    for i,line in enumerate(L):
        mname=re.match(r'(?:#+\s*)?Angebot:\s*(.+)$',line,re.I)
        if not mname: continue
        name=mname.group(1).strip()
        name=re.split(r'\s+(?:App[-\s]*Preis|Festpreis|Gültig\s+ab|Tag:)\b',name,maxsplit=1,flags=re.I)[0].strip(' -–:')
        name=clean_product_name(name)
        if not name or name.lower() in {'angebot','angebote der woche'} or product_name_issue(name): continue
        block=' '.join(L[i:min(i+16,len(L))])
        fest=re.search(r'Festpreis von\s+(\d+[.,]\d+)\s*€',block,re.I)
        app=re.search(r'App[\s-]*Preis von\s+(\d+[.,]\d+)\s*€',block,re.I)
        if not fest: continue
        q,u=size(block);im=best_img(imgs,name)
        out.append(CollectedOffer(
            source.key,source.store_name,source.retailer,name,cat(name),
            float(fest.group(1).replace(',','.')),
            app_price=float(app.group(1).replace(',','.')) if app else None,
            unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,valid_from=vf,valid_to=vt,
            source_text=block,source_url=source.url,
            image_url=im['url'] if im else None,image_alt=im['alt'] if im else None,confidence=.97
        ))
    if not out:
        flat=re.sub(r'\s+',' ',text)
        pat=re.compile(r'Angebot\s*:?\s*([A-ZÄÖÜ0-9][^€]{2,100}?)\s+(?:App[-\s]*Preis.*?(\d+[.,]\d+)\s*€.*?)?Festpreis\s+von\s+(\d+[.,]\d+)\s*€',re.I)
        for m in pat.finditer(flat):
            name=clean_product_name(m.group(1).strip(' -–:'))
            if product_name_issue(name): continue
            block=flat[m.start():min(len(flat),m.end()+350)]
            q,u=size(block);im=best_img(imgs,name)
            out.append(CollectedOffer(
                source.key,source.store_name,source.retailer,name[:180],cat(name),
                float(m.group(3).replace(',','.')),
                app_price=float(m.group(2).replace(',','.')) if m.group(2) else None,
                unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,valid_from=vf,valid_to=vt,
                source_text=block,source_url=source.url,
                image_url=im['url'] if im else None,image_alt=im['alt'] if im else None,confidence=.93
            ))
    seen=set();res=[]
    for r in out:
        k=(r.product_name.lower(),r.price,r.app_price,r.quantity,r.unit)
        if k not in seen:
            seen.add(k);res.append(r)
    return res

def parse_netto_text(source,text,imgs=None):
    L=[x.strip() for x in text.splitlines() if x.strip()];imgs=imgs or [];out=[]
    section_start=None; section_end=len(L)
    for i,line in enumerate(L):
        if re.search(r'filial[\s-]*angebote',line,re.I):
            section_start=i+1;break
    if section_start is None:
        section_start=0
    for i in range(section_start,len(L)):
        if i>section_start and any(x in L[i].lower() for x in ('aktuelle prospekte','filialen in der nähe','stellenangebote für die filiale')):
            section_end=i;break

    i=section_start
    while i<section_end:
        line=L[i]
        q,u=size(line)
        if q is None:
            i+=1;continue

        name=line
        if re.fullmatch(r'\d+(?:[.,]\d+)?\s*(?:kg|g|l|ml|stück|stk\.?|becher|dose|flasche|pckg\.?|btl\.?)',line,re.I):
            name=_best_candidate_name(L,i-3,i)
        elif len(line)<4:
            name=_best_candidate_name(L,i-3,i+1)
        name=clean_product_name(name)
        if not name or _is_noise_line(name) or product_name_issue(name):
            i+=1;continue

        j=min(section_end,i+12)
        for k in range(i+1,j):
            lowk=L[k].lower().strip()
            if lowk in {"filiale","filiale & shop"}:
                j=k
                break
            q2,u2=size(L[k])
            if q2 is not None and k>=i+2:
                candidate=_best_candidate_name(L,max(i+1,k-3),k+1)
                if candidate and clean_product_name(candidate).lower()!=name.lower():
                    j=max(i+2,k-1)
                    break
        block_lines=L[max(section_start,i-1):j]
        block=' '.join(block_lines)
        vals=_price_without_unit_prices(block)
        if not vals:
            i+=1;continue

        pair=re.search(r'(?:statt|UVP)\s+(\d{1,3}[.,]\d{2})\s+(\d{1,3}[.,]\d{2})',block,re.I)
        regular=promo=None
        if pair:
            regular=float(pair.group(1).replace(',','.'))
            promo=float(pair.group(2).replace(',','.'))
        else:
            promo=min(vals)
            regular=None

        app_price=None
        after=block[pair.end():] if pair else block
        extra=_price_without_unit_prices(after)
        lower=[v for v in extra if v<promo]
        if lower:
            explicit=bool(re.search(r'\b(?:app|netto\+|coupon|vorteilspreis|digitaler\s+coupon)\b',block,re.I))
            trailing_price=bool(re.search(r'\b\d{1,3}[.,]\d{2}\s*(?:\*|€)?\s*\([^)]*(?:kg|l)[^)]*\)\s*$',block,re.I))
            if explicit or trailing_price:
                app_price=min(lower)

        im=best_img(imgs,name)
        out.append(CollectedOffer(
            source.key,source.store_name,source.retailer,name[:180],cat(name),promo,
            regular_price=regular,app_price=app_price,unit_price=upr(block),unit_price_unit=upr_unit(block),quantity=q,unit=u,
            source_text=block,source_url=source.url,image_url=im['url'] if im else None,
            image_alt=im['alt'] if im else None,confidence=.95
