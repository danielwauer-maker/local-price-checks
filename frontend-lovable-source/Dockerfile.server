FROM oven/bun:1.2.23-slim AS deps
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile

FROM oven/bun:1.2.23-slim AS build
WORKDIR /app
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_PUBLISHABLE_KEY
ENV NODE_ENV=production
ENV NITRO_PRESET=node-server
ENV VITE_SUPABASE_URL=${VITE_SUPABASE_URL}
ENV VITE_SUPABASE_PUBLISHABLE_KEY=${VITE_SUPABASE_PUBLISHABLE_KEY}
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN test -f public/brand/spareno-icon-192.png \
    && test -f public/brand/spareno-icon-512.png \
    && test -f public/brand/spareno-maskable-512.png \
    && test -f public/brand/apple-touch-icon.png \
    && test -f public/brand/favicon-32.png \
    && bun run build \
    && test -f .output/server/index.mjs

FROM node:22.14.0-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=80
COPY --from=build /app/.output ./.output
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD node -e "fetch('http://127.0.0.1/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
USER node
CMD ["node", ".output/server/index.mjs"]
