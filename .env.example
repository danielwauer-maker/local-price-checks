APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:////app/data/local_price_checks.sqlite3
# Defaults to true for SQLite and false for PostgreSQL. Keep false on PostgreSQL;
# create/upgrade its schema with Alembic before starting the application.
AUTO_CREATE_SCHEMA=true
# Local docker compose --profile postgres development defaults only.
POSTGRES_DB=lokero
POSTGRES_USER=lokero
POSTGRES_PASSWORD=lokero_dev_only
POSTGRES_PORT=5432
DATA_DIR=/app/data
DEFAULT_RADIUS_KM=15
LOCAL_DATE_OVERRIDE=
SCHEDULER_ENABLED=false
MANUAL_COLLECTION_ENABLED=false
COLLECTION_HOUR=5
COLLECTION_MINUTE=30
COLLECTOR_BROWSER_ENABLED=false
COLLECTOR_TIMEOUT_SECONDS=30
# Audit-built retailer web collectors stay opt-in until their regional
# production benchmarks have been accepted. The admin Web-Angebots-Audit is
# still available explicitly while these flags are false.
WEB_COLLECTOR_NETTO=false
WEB_COLLECTOR_EDEKA=false
WEB_COLLECTOR_PENNY=false
WEB_COLLECTOR_ALDI_SUED=false
WEB_COLLECTOR_NORMA=false
STALE_AFTER_HOURS=36
STORE_QUALITY_MIN_VALID_OFFERS=10
STORE_QUALITY_MIN_PRICE_COVERAGE_PCT=80
STORE_QUALITY_MAX_DUPLICATE_RATE_PCT=10
STORE_QUALITY_MAX_INVALID_RATE_PCT=20
DRIVING_COST_PER_KM=0.15
# Road-distance matrix provider used by the shopping optimizer. The public OSRM
# endpoint is suitable for the small manual realtest; production-scale traffic
# should later use a dedicated/self-hosted provider behind the same adapter.
ROUTING_BASE_URL=https://router.project-osrm.org
ROUTING_TIMEOUT_SECONDS=5
# Used only when road routing is unavailable.
ROUTE_DISTANCE_FACTOR=1.25
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Public Supabase project settings used by the backend only to validate user access tokens.
# Never place a service-role/secret key here for browser use.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
